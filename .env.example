# Copie para .env (que NAO vai para o git) e preencha.
# Chave gratuita: https://aistudio.google.com/api-keys
GEMINI_API_KEY=cole-sua-chave-aqui

# Modelos: confirme no AI Studio quais estao no nivel gratuito.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# API publica do Sir Barber usada pelas ferramentas (somente leitura, loja demo).
SIRBARBER_API_BASE=
SIRBARBER_DEMO_TENANT=

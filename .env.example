# Copie para .env (que NAO vai para o git) e preencha.
# Chave gratuita: https://aistudio.google.com/api-keys
GEMINI_API_KEY=cole-sua-chave-aqui

# Modelos: confirme no AI Studio quais estao no nivel gratuito.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# API publica do Sir Barber usada pelas ferramentas (somente leitura, loja demo).
SIRBARBER_API_BASE=
SIRBARBER_DEMO_TENANT=

# --- API (todas opcionais; o padrao ja e restritivo) ---
# ALLOWED_TENANTS=platform
# RATE_PER_MINUTE=6
# RATE_PER_DAY=60
# DAILY_CAP=400
# MAX_BODY_BYTES=4096
# CLIENT_IP_HEADER=        # so atras de proxy confiavel que sobrescreve esse cabecalho
# CORS_ORIGINS=            # origens https://... separadas por virgula; "*" e recusado
# METRICS_TOKEN=           # liga /metrics; minimo 16 caracteres
